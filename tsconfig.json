{
	"extends": [
		"@vue/tsconfig/tsconfig.dom.json",
		"@vue/tsconfig/tsconfig.lib.json"
	],
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"paths": {
			"ol": ["./node_modules/ol"],
			"ol/*": ["./node_modules/ol/*"]
		},
		"types": [
			"vitest/importMeta",
			"vitest/jsdom",
			"node",
			"vite-plugin-kern-extra-icons/client"
		],

		"noImplicitAny": false,
		"importHelpers": true,
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"noEmit": true,
		"isolatedModules": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.vue",
		"vite.config.ts",
		"eslint.config.ts",
		"stylelint.config.ts"
	],
	"exclude": ["node_modules", "dist"]
}
