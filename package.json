{
	"name": "@polar/client-meldemichel",
	"version": "2.0.0-alpha.0",
	"description": "POLAR Client Meldemichel. This client aids in crowd-sourcing the detection of Hamburg's infrastructure in need of repair or maintenance.",
	"keywords": [
		"OpenLayers",
		"ol",
		"POLAR",
		"client",
		"Meldemichel",
		"reporting",
		"infrastructure"
	],
	"license": "EUPL-1.2",
	"type": "module",
	"author": "Dataport AöR <polar@dataport.de>",
	"main": "dist/polar-client.js",
	"module": "dist/polar-client.js",
	"types": "dist/polar-client.d.ts",
	"exports": {
		".": {
			"types": "./dist/polar-client.d.ts",
			"default": "./dist/polar-client.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Dataport/polar-client-meldemichel.git"
	},
	"files": [
		"dist/**/*",
		"example/**/*",
		"API.md",
		"CHANGELOG.md",
		"README.md"
	],
	"scripts": {
		"dev": "vite --host",
		"build": "vite build && copyfiles -f src/html/index.html dist && copyfiles -f node_modules/@polar/polar/dist/polar.css dist",
		"preview": "vite preview",
		"lint": "eslint --cache --cache-location .eslintcache --cache-strategy content .",
		"lint:fix": "npm run lint -- --fix",
		"tsc": "tsc && vue-tsc --noEmit",
		"test": "vitest",
		"test:ci": "vitest run",
		"test:coverage": "vitest run --coverage --ui",
		"prepare": "node .husky/install.js"
	},
	"dependencies": {
		"es-toolkit": "^1.52.0"
	},
	"peerDependencies": {
		"@kern-ux/native": "^2.8.2",
		"@polar/polar": "^3.0.0-alpha.5",
		"ol": "10.10.0",
		"pinia": "^4.0.3",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@dataport/eslint-config-geodev": "^2.0.0-alpha.3",
		"@microsoft/api-extractor": "^7.59.3",
		"@pinia/testing": "^2.0.1",
		"@types/geojson": "7946.0.16",
		"@types/node": "^24.13.6",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vitest/coverage-v8": "^5.0.2",
		"@vitest/ui": "^5.0.2",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.0",
		"copyfiles": "^2.4.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-prettier": "^5.5.6",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"typescript": "~6.0.3",
		"unplugin-dts": "^1.1.1",
		"vite": "^8.3.1",
		"vite-plugin-checker": "^0.14.5",
		"vite-plugin-kern-extra-icons": "^1.0.1",
		"vitest": "^5.0.2",
		"vue-tsc": "^3.3.11"
	}
}
